{
  "name": "standard",
  "description": "标准计算器模式黄金向量：四则运算、优先级、括号、乘方、取模、内建函数、数值显示格式",
  "defaults": { "mode": "standard", "base": "dec", "wordsize": "32" },
  "cases": [
    { "expr": "2+3", "expect": "5" },
    { "expr": "10-4", "expect": "6" },
    { "expr": "6*7", "expect": "42" },
    { "expr": "10/4", "expect": "2.5" },
    { "expr": "10/5", "expect": "2" },
    { "expr": "1/8", "expect": "0.125" },
    { "expr": "100-250", "expect": "-150" },
    { "expr": "-5+10", "expect": "5" },
    { "expr": "0-7", "expect": "-7" },
    { "expr": "2.5+2.5", "expect": "5" },
    { "expr": "2+3*4", "expect": "14" },
    { "expr": "(2+3)*4", "expect": "20" },
    { "expr": "2*3+4*5", "expect": "26" },
    { "expr": "100/10/2", "expect": "5" },
    { "expr": "2+3-4+5", "expect": "6" },
    { "expr": "8/2*3", "expect": "12" },
    { "expr": "((1+2)*(3+4))", "expect": "21" },
    { "expr": "(2*(3+(4-1)))", "expect": "12" },
    { "expr": "999999*999999", "expect": "999998000001" },
    { "expr": "2^0", "expect": "1" },
    { "expr": "2^1", "expect": "2" },
    { "expr": "2^10", "expect": "1024" },
    { "expr": "3^3", "expect": "27" },
    { "expr": "2**8", "expect": "256" },
    { "expr": "5^2", "expect": "25" },
    { "expr": "2^-1", "expect": "0.5" },
    { "expr": "9^0.5", "expect": "3" },
    { "expr": "mod(10,3)", "expect": "1" },
    { "expr": "mod(7,2)", "expect": "1" },
    { "expr": "10%3", "expect": "1" },
    { "expr": "20%7", "expect": "6" },
    { "expr": "abs(-5)", "expect": "5" },
    { "expr": "abs(5)", "expect": "5" },
    { "expr": "trunc(3.7)", "expect": "3" },
    { "expr": "trunc(-3.7)", "expect": "-3" },
    { "expr": "round(3.4)", "expect": "3" },
    { "expr": "round(3.5)", "expect": "4" },
    { "expr": "floor(3.9)", "expect": "3" },
    { "expr": "floor(-3.1)", "expect": "-4" },
    { "expr": "ceil(3.1)", "expect": "4" },
    { "expr": "ceil(-3.9)", "expect": "-3" },
    { "expr": "sign(-9)", "expect": "-1" },
    { "expr": "sign(0)", "expect": "0" },
    { "expr": "sign(9)", "expect": "1" },
    { "expr": "sqr(4)", "expect": "16" },
    { "expr": "sqr(0.5)", "expect": "0.25" },
    { "expr": "sqrt(16)", "expect": "4" },
    { "expr": "sqrt(0)", "expect": "0" },
    { "expr": "sqrt(2)", "expect": "1.4142135623730951" },
    { "expr": "min(3,1,2)", "expect": "1" },
    { "expr": "max(3,1,2)", "expect": "3" },
    { "expr": "sum(1,2,3)", "expect": "6" },
    { "expr": "sum(1,2,3,4)", "expect": "10" },
    { "expr": "average(1,2,3)", "expect": "2" },
    { "expr": "average(2,4)", "expect": "3" },
    { "expr": "clamp(5,1,3)", "expect": "3" },
    { "expr": "clamp(-5,1,3)", "expect": "1" },
    { "expr": "clamp(2,1,3)", "expect": "2" },
    { "expr": "0.1+0.2", "arith": "double", "expect": "0.30000000000000004", "note": "double 下 0.1/0.2 的表示误差不会抵消，如实显示而不抹成 0.3" },
    { "expr": "0.1+0.2", "arith": "extended", "expect": "0.3", "note": "80 位扩展精度下两个加数的表示误差在更高精度里抵消，舍入回 17 位有效数字正好是 0.3；显示层统一按 double 精度收敛，所以两边显示的都是『最短可还原表示』，只是被舍入前的值不同" },
    { "expr": "1/3", "expect": "0.3333333333333333" },
    { "expr": "1.5+1.5", "expect": "3" },
    { "expr": "1000000*1000000", "expect": "1000000000000" },
    { "expr": "1e3", "expect": "1000" },
    { "expr": "1e-3", "expect": "0.001" },
    { "expr": "2.5e2", "expect": "250" },
    { "expr": "1&&1", "expect": "1" },
    { "expr": "1&&0", "expect": "0" },
    { "expr": "0||0", "expect": "0" },
    { "expr": "1||0", "expect": "1" },
    { "expr": "not(0)", "expect": "1" },
    { "expr": "not(1)", "expect": "0" },
    { "expr": "isodd(3)", "expect": "1" },
    { "expr": "iseven(4)", "expect": "1" },
    { "expr": "isodd(4)", "expect": "0" },
    { "expr": "iseven(3)", "expect": "0" },
    { "expr": "if(1,10,20)", "expect": "10" },
    { "expr": "if(0,10,20)", "expect": "20" },
    { "expr": "-(5)", "expect": "-5" },
    { "expr": "-(-5)", "expect": "5" },
    { "expr": "3--2", "expect": "5" },
    { "expr": "0", "expect": "0" },
    { "expr": "0-0", "expect": "0" },
    { "expr": "  8  +  2  ", "expect": "10", "note": "首尾与中间空白应被容忍" },
    { "expr": "2*3*4*5*6", "expect": "720" },
    { "expr": "((((1))))", "expect": "1" },
    { "expr": "123456789+1", "expect": "123456790" },
    { "expr": "1000000000000+1", "expect": "1000000000001" }
  ]
}
