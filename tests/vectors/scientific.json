{
  "name": "scientific",
  "description": "科学计算器模式黄金向量：三角/反三角/双曲、对数与指数、幂、阶乘与排列组合、常量",
  "defaults": { "mode": "scientific", "base": "dec", "wordsize": "32" },
  "cases": [
    { "expr": "sin(0)", "expect": "0" },
    { "expr": "cos(0)", "expect": "1" },
    { "expr": "tan(0)", "expect": "0" },
    { "expr": "sin(pi/2)", "expect": "1" },
    { "expr": "cos(pi)", "expect": "-1" },
    { "expr": "tan(pi/4)", "expect_value": 1.0, "tolerance": 1e-15 },
    { "expr": "sin(pi/6)", "expect_value": 0.5, "tolerance": 1e-15 },
    { "expr": "cot(pi/4)", "expect_value": 1.0, "tolerance": 1e-15 },
    { "expr": "sin(pi)", "expect_value": 0.0, "tolerance": 1e-15 },
    { "expr": "cos(pi/3)", "expect_value": 0.5, "tolerance": 1e-15 },
    { "expr": "asin(0)", "expect": "0" },
    { "expr": "asin(1)", "expect_value": 1.5707963267948966, "tolerance": 1e-15 },
    { "expr": "acos(1)", "expect": "0" },
    { "expr": "acos(0)", "expect_value": 1.5707963267948966, "tolerance": 1e-15 },
    { "expr": "atan(1)", "expect_value": 0.7853981633974483, "tolerance": 1e-15 },
    { "expr": "atan2(1,1)", "expect_value": 0.7853981633974483, "tolerance": 1e-15 },
    { "expr": "atan2(0,1)", "expect": "0" },
    { "expr": "atan2(1,0)", "expect_value": 1.5707963267948966, "tolerance": 1e-15 },
    { "expr": "sinh(0)", "expect": "0" },
    { "expr": "cosh(0)", "expect": "1" },
    { "expr": "tanh(0)", "expect": "0" },
    { "expr": "cosh(1)", "expect_value": 1.5430806348152437, "tolerance": 1e-15 },
    { "expr": "sinh(1)", "expect_value": 1.1752011936438014, "tolerance": 1e-15 },
    { "expr": "tanh(1)", "expect_value": 0.7615941559557649, "tolerance": 1e-15 },
    { "expr": "ln(1)", "expect": "0" },
    { "expr": "ln(e)", "expect": "1" },
    { "expr": "ln(2)", "expect_value": 0.6931471805599453, "tolerance": 1e-15 },
    { "expr": "log10(1)", "expect": "0" },
    { "expr": "log10(100)", "expect": "2" },
    { "expr": "log10(1000)", "expect": "3" },
    { "expr": "log10(2)", "expect_value": 0.3010299956639812, "tolerance": 1e-15 },
    { "expr": "exp(0)", "expect": "1" },
    { "expr": "exp(1)", "expect_value": 2.718281828459045, "tolerance": 1e-15 },
    { "expr": "exp(2)", "expect_value": 7.38905609893065, "tolerance": 1e-14 },
    { "expr": "exp(-1)", "expect_value": 0.36787944117144233, "tolerance": 1e-15 },
    { "expr": "pow(2,10)", "expect": "1024" },
    { "expr": "power(2,10)", "expect": "1024" },
    { "expr": "pow(2,0.5)", "expect_value": 1.4142135623730951, "tolerance": 1e-15 },
    { "expr": "pow(9,0.5)", "expect": "3" },
    { "expr": "pow(2,-2)", "expect": "0.25" },
    { "expr": "fac(0)", "expect": "1" },
    { "expr": "fac(1)", "expect": "1" },
    { "expr": "fac(5)", "expect": "120" },
    { "expr": "fac(10)", "expect": "3628800" },
    { "expr": "fact(5)", "expect": "120" },
    { "expr": "fac(3)+fac(4)", "expect": "30" },
    { "expr": "combin(5,2)", "expect": "10" },
    { "expr": "ncr(5,2)", "expect": "10" },
    { "expr": "combin(10,3)", "expect": "120" },
    { "expr": "permut(5,2)", "expect": "20" },
    { "expr": "npr(5,2)", "expect": "20" },
    { "expr": "permut(10,3)", "expect": "720" },
    { "expr": "tgamma(5)", "expect": "24" },
    { "expr": "tgamma(1)", "expect": "1" },
    { "expr": "tgamma(0.5)", "expect_value": 1.7724538509055159, "tolerance": 1e-14 },
    { "expr": "pi", "expect": "3.141592653589793" },
    { "expr": "e", "expect": "2.718281828459045" },
    { "expr": "pi*2", "expect": "6.283185307179586" },
    { "expr": "pi/2", "expect": "1.5707963267948966" },
    { "expr": "true", "expect": "1" },
    { "expr": "false", "expect": "0" },
    { "expr": "e^2", "expect_value": 7.38905609893065, "tolerance": 1e-14 },
    { "expr": "ln(exp(3))", "expect_value": 3.0, "tolerance": 1e-14 },
    { "expr": "sqrt(2)*sqrt(2)", "expect_value": 2.0, "tolerance": 1e-15 },
    { "expr": "sin(0)+cos(0)+tan(0)", "expect": "1" },
    { "expr": "abs(sin(pi/2))", "expect": "1" },
    { "expr": "round(pi)", "expect": "3" },
    { "expr": "floor(pi)", "expect": "3" },
    { "expr": "ceil(pi)", "expect": "4" },
    { "expr": "trunc(e)", "expect": "2" },
    { "expr": "max(pi,e)", "expect": "3.141592653589793" },
    { "expr": "min(pi,e)", "expect": "2.718281828459045" },
    { "expr": "2^10+2^10", "expect": "2048" },
    { "expr": "sqrt(sqr(7))", "expect": "7" },
    { "expr": "sqr(sin(pi/2))", "expect": "1" },
    { "expr": "exp(ln(5))", "expect_value": 5.0, "tolerance": 1e-14 },
    { "expr": "log10(10^5)", "expect_value": 5.0, "tolerance": 1e-13 },
    { "expr": "combin(52,5)", "expect": "2598960" },
    { "expr": "permut(6,6)", "expect": "720" },
    { "expr": "fac(5)/fac(3)", "expect": "20" },
    { "expr": "iseven(fac(3))", "expect": "1" },
    { "expr": "cos(2*pi)", "expect": "1" },
    { "expr": "sin(pi/4)*sqrt(2)", "expect_value": 1.0, "tolerance": 1e-15 },
    { "expr": "tan(pi/3)", "expect_value": 1.7320508075688767, "tolerance": 1e-14 },
    { "expr": "(1+1)^(3+2)", "expect": "32" },
    { "expr": "atan(1)*4", "expect": "3.141592653589793" }
  ]
}
