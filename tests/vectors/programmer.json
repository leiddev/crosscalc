{
  "name": "programmer",
  "description": "程序员计算器模式黄金向量：按位函数、位移与循环移位、十六进制字面量、多进制显示、字长截断、64 位平台门控",
  "defaults": { "mode": "programmer", "base": "dec", "wordsize": "32" },
  "cases": [
    { "expr": "bitand(12,10)", "expect": "8" },
    { "expr": "bitor(12,10)", "expect": "14" },
    { "expr": "bitxor(12,10)", "expect": "6" },
    { "expr": "bitand(255,15)", "expect": "15" },
    { "expr": "bitor(240,15)", "expect": "255" },
    { "expr": "bitxor(255,255)", "expect": "0" },
    { "expr": "bitlshift(1,10)", "expect": "1024" },
    { "expr": "bitrshift(1024,10)", "expect": "1" },
    { "expr": "bitand(0xFFFFFFFFFFFF,1)", "expect": "1", "note": "2^48-1 恰好是库允许的按位运算上限" },
    { "expr": "1<<10", "expect": "1024" },
    { "expr": "1<<0", "expect": "1" },
    { "expr": "1024>>4", "expect": "64" },
    { "expr": "1024>>10", "expect": "1" },
    { "expr": "255>>4", "expect": "15" },
    { "expr": "1<<31", "expect": "-2147483648", "note": "32 位字长下最高位为符号位" },
    { "expr": "1<<32", "expect": "0", "note": "超出 32 位字长被截断" },
    { "expr": "0xFF<<4", "expect": "4080" },
    { "expr": "0xFF<<4", "base": "hex", "expect": "FF0" },
    { "expr": "bitlrotate8(1,1)", "expect": "2" },
    { "expr": "bitrrotate8(1,1)", "expect": "128" },
    { "expr": "bitlrotate8(129,1)", "expect": "3" },
    { "expr": "bitlrotate16(0x8000,1)", "expect": "1" },
    { "expr": "bitrrotate16(1,1)", "expect": "32768" },
    { "expr": "bitlrotate8(1,1)", "base": "hex", "expect": "2" },
    { "expr": "bitrrotate8(1,1)", "base": "bin", "expect": "1000 0000" },
    { "expr": "0xFF", "expect": "255" },
    { "expr": "0xff+1", "expect": "256" },
    { "expr": "0x10*0x10", "expect": "256" },
    { "expr": "0x0", "expect": "0" },
    { "expr": "0xDEADBEEF", "base": "hex", "expect": "DEADBEEF" },
    { "expr": "0xDEADBEEF", "base": "dec", "expect": "-559038737", "note": "32 位下按二补数解释为负数" },
    { "expr": "255", "base": "hex", "expect": "FF" },
    { "expr": "255", "base": "oct", "expect": "377" },
    { "expr": "255", "base": "bin", "expect": "1111 1111" },
    { "expr": "255", "base": "dec", "expect": "255" },
    { "expr": "0", "base": "hex", "expect": "0" },
    { "expr": "0", "base": "bin", "expect": "0" },
    { "expr": "4096", "base": "hex", "expect": "1000" },
    { "expr": "4096", "base": "bin", "expect": "1 0000 0000 0000" },
    { "expr": "bitnot8(0)", "base": "hex", "expect": "FF" },
    { "expr": "bitnot16(0)", "base": "hex", "expect": "FFFF" },
    { "expr": "bitnot32(0)", "base": "hex", "expect": "FFFFFFFF" },
    { "expr": "bitnot8(0)", "wordsize": "8", "base": "dec", "expect": "-1", "note": "字长 8 下按二补数解释" },
    { "expr": "bitnot16(0)", "wordsize": "16", "base": "dec", "expect": "-1" },
    { "expr": "bitnot32(0)", "base": "dec", "expect": "-1" },
    { "expr": "bitnot8(0)", "expect": "255", "note": "默认字长 32，255 在 32 位里是正数，所以不显示 -1" },
    { "expr": "bitnot16(0)", "expect": "65535" },
    { "expr": "0xFFFFFFFF", "base": "hex", "expect": "FFFFFFFF" },
    { "expr": "0xFFFFFFFF", "base": "dec", "expect": "-1" },
    { "expr": "0x80000000", "base": "dec", "expect": "-2147483648" },
    { "expr": "0xFFF", "wordsize": "16", "base": "hex", "expect": "FFF" },
    { "expr": "0xFFF", "wordsize": "8", "base": "hex", "expect": "FF" },
    { "expr": "256", "wordsize": "8", "base": "dec", "expect": "0", "note": "BYTE 字长下 256 截断为 0" },
    { "expr": "255", "wordsize": "8", "base": "dec", "expect": "-1" },
    { "expr": "127", "wordsize": "8", "base": "dec", "expect": "127" },
    { "expr": "128", "wordsize": "8", "base": "dec", "expect": "-128" },
    { "expr": "65535", "wordsize": "16", "base": "dec", "expect": "-1" },
    { "expr": "65536", "wordsize": "16", "base": "hex", "expect": "0" },
    { "expr": "0xFFFF", "wordsize": "16", "base": "hex", "expect": "FFFF" },
    { "expr": "0x1FFFF", "wordsize": "16", "base": "hex", "expect": "FFFF" },
    { "expr": "hex2dec(\"FF\")", "expect": "255" },
    { "expr": "hex2dec(\"ff\")", "expect": "255" },
    { "expr": "hex2dec(\"FF\")+1", "expect": "256" },
    { "expr": "hex2dec(\"10\")", "expect": "16" },
    { "expr": "bin2dec(\"1010\")", "expect": "10" },
    { "expr": "bin2dec(\"11111111\")", "expect": "255" },
    { "expr": "oct2dec(\"17\")", "expect": "15" },
    { "expr": "oct2dec(\"377\")", "expect": "255" },
    { "expr": "10/4", "expect": "2.5", "note": "非整数结果退化为一般十进制显示" },
    { "expr": "2.5+2.5", "expect": "5" },
    { "expr": "0-1", "base": "dec", "expect": "-1" },
    { "expr": "0-1", "base": "hex", "expect": "FFFFFFFF" },
    { "expr": "0xFFFFFFFF+1", "base": "hex", "expect": "0", "note": "32 位环绕" },
    { "expr": "bitand(bitnot8(0),0x0F)", "base": "hex", "expect": "F" },
    { "expr": "bitor(0xF0,0x0F)", "base": "hex", "expect": "FF" },
    { "expr": "bitxor(0xF0,0x0F)", "base": "bin", "expect": "1111 1111" },
    { "expr": "bitlshift(1,15)", "base": "hex", "expect": "8000" },
    { "expr": "bitrshift(0x8000,15)", "base": "dec", "expect": "1" },
    { "expr": "max(bitand(12,10),bitor(12,10))", "expect": "14" },
    { "expr": "iseven(bitand(12,10))", "expect": "1" },

    { "expr": "0xFFFFFFFFFFFFFFFF", "base": "hex", "wordsize": "64", "requires_64bit": true, "expect": "FFFFFFFFFFFFFFFF" },
    { "expr": "bitnot64(0)", "base": "hex", "wordsize": "64", "requires_64bit": true, "expect": "FFFFFFFFFFFFFFFF" },
    { "expr": "bitlrotate64(1,32)", "base": "hex", "wordsize": "64", "requires_64bit": true, "expect": "100000000" },
    { "expr": "bitrrotate64(1,1)", "base": "hex", "wordsize": "64", "requires_64bit": true, "expect": "8000000000000000" },
    { "expr": "1<<62", "base": "hex", "wordsize": "64", "requires_64bit": true, "expect": "4000000000000000" },

    { "expr": "bin2dec(\"101\")", "expect": "5", "note": "库的 BIN2DEC 只能处理短数字" },
    { "expr": "bin2dec(\"1111111111\")", "expect": "-1", "note": "正好 10 位时按【有符号 10 位】解释，所以 10 个 1 是 -1 而不是 1023" },
    { "expr": "oct2dec(\"777\")", "expect": "511" },
    { "expr": "hex2dec(\"FFFFFFFF\") == 4294967295", "expect": "1", "note": "位数不足 10 时按无符号解释；用等式判断以免被字长掩码影响" },
    { "expr": "hex2dec(\"FFFFFFFFFF\")", "expect": "-1", "note": "正好 10 位时按【有符号 40 位】解释，10 个 F 是 -1" },
    { "expr": "hex2dec(\"ZZ\")", "expect_error": true, "error_contains": "进制转换失败", "note": "非法十六进制数字 -> 库静默返回 NaN，由本项目翻译成中文提示" },
    { "expr": "hex2dec(\"12345678901\")", "expect_error": true, "error_contains": "超过上限", "note": "11 位超过库的 10 位上限" }
  ]
}
