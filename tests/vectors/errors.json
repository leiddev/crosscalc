{
  "name": "errors",
  "description": "错误处理黄金向量：确认每一类失败都给出中文友好提示，且不会静默给出错误结果",
  "defaults": { "mode": "standard", "base": "dec", "wordsize": "32" },
  "cases": [
    { "expr": "1/0", "expect_error": true, "error_contains": "除数不能为零" },
    { "expr": "0/0", "expect_error": true, "error_contains": "除数不能为零" },
    { "expr": "5/0", "expect_error": true, "error_contains": "除数不能为零" },
    { "expr": "1/(2-2)", "expect_error": true, "error_contains": "除数不能为零" },
    { "expr": "mod(1,0)", "expect_error": true, "error_contains": "除数不能为零" },
    { "expr": "1%0", "expect_error": true, "error_contains": "除数不能为零" },
    { "expr": "sqrt(-1)", "expect_error": true, "error_contains": "不能对负数开平方" },
    { "expr": "sqrt(-4)", "expect_error": true, "error_contains": "不能对负数开平方" },
    { "expr": "asin(2)", "expect_error": true, "error_contains": "ASIN" },
    { "expr": "asin(-2)", "expect_error": true, "error_contains": "ASIN" },
    { "expr": "foo+1", "expect_error": true, "error_contains": "未知的符号" },
    { "expr": "foo+1", "expect_error": true, "error_contains": "'foo'" },
    { "expr": "1+bar", "expect_error": true, "error_contains": "未知的符号" },
    { "expr": "x", "expect_error": true, "error_contains": "未知的符号" },
    { "expr": "nosuchfn(1)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "log2(8)", "expect_error": true, "error_contains": "未知的函数", "note": "库不提供 log2，按需求约定不自行实现" },
    { "expr": "sec(0)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "csc(1)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "asinh(0)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "acosh(1)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "atanh(0)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "gcd(4,6)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "lcm(4,6)", "expect_error": true, "error_contains": "未知的函数" },
    { "expr": "2+", "expect_error": true, "error_contains": "表达式不完整" },
    { "expr": "2*", "expect_error": true, "error_contains": "表达式不完整" },
    { "expr": "2-", "expect_error": true, "error_contains": "表达式不完整" },
    { "expr": "50%", "expect_error": true, "error_contains": "表达式不完整", "note": "% 在库里是取模，不是百分比，需求已确认不支持百分比" },
    { "expr": "+", "expect_error": true, "error_contains": "表达式不完整" },
    { "expr": "*3", "expect_error": true, "error_contains": "运算符" },
    { "expr": "2+*3", "expect_error": true, "error_contains": "运算符" },
    { "expr": "(1+2", "expect_error": true, "error_contains": "右括号" },
    { "expr": "((1+2)", "expect_error": true, "error_contains": "右括号" },
    { "expr": "1+2)", "expect_error": true, "error_contains": "右括号" },
    { "expr": "(1+2))", "expect_error": true, "error_contains": "右括号" },
    { "expr": "", "expect_error": true, "error_contains": "请输入" },
    { "expr": "   ", "expect_error": true, "error_contains": "请输入" },
    { "expr": "hex2dec(\"ZZ\")", "expect_error": true, "error_contains": "进制转换失败" },
    { "expr": "hex2dec(\"G1\")", "expect_error": true, "error_contains": "进制转换失败" },
    { "expr": "hex2dec(\"\")", "expect_error": true, "error_contains": "进制转换失败" },
    { "expr": "bin2dec(\"2\")", "expect_error": true, "error_contains": "进制转换失败" },
    { "expr": "bin2dec(\"12\")", "expect_error": true, "error_contains": "进制转换失败" },
    { "expr": "oct2dec(\"9\")", "expect_error": true, "error_contains": "进制转换失败" },
    { "expr": "oct2dec(\"8\")", "expect_error": true, "error_contains": "进制转换失败" },
    { "expr": "0b1010", "expect_error": true, "error_contains": "未知的符号", "note": "0b/0o 字面量不被支持，需用 BIN2DEC()" },
    { "expr": "0o17", "expect_error": true, "error_contains": "未知的符号" },
    { "expr": "bitand(1.5,1)", "mode": "programmer", "expect_error": true, "error_contains": "整数" },
    { "expr": "bitand(0x1000000000000,1)", "mode": "programmer", "expect_error": true, "error_contains": "超出按位运算允许的范围" },
    { "expr": "1<<64", "mode": "programmer", "expect_error": true, "error_contains": "" },
    { "expr": "FF+1", "mode": "programmer", "base": "hex", "expect_error": true, "error_contains": "0x", "note": "十六进制字面量必须带 0x 前缀" },
    { "expr": "DEADBEEF", "mode": "programmer", "base": "hex", "expect_error": true, "error_contains": "0x" },
    { "expr": "log(0)", "expect_error": true, "error_contains": "", "note": "库只有 LN/LOG10，没有 LOG" },
    { "expr": "log(100)", "expect_error": true, "error_contains": "" },
    { "expr": "ln(0)", "expect_error": true, "error_contains": "" },
    { "expr": "ln(-1)", "expect_error": true, "error_contains": "" },
    { "expr": "tan(pi/2)", "expect_error": false, "note": "pi/2 无法被 double 精确表示，因此 tan(pi/2) 不是无穷大而是一个很大的有限值；这是 IEEE 754 的正常行为，不是错误" },
    { "expr": "1e9999", "expect_error": true, "error_contains": "", "note": "超出 long double 的上限（约 1.19e4932），在两种运算精度下都溢出" },
    { "expr": "1e999", "arith": "double", "expect_error": true, "error_contains": "", "note": "超出 double 上限但没超出 long double，只在 double 平台上算溢出" },
    { "expr": "5!", "expect_error": true, "error_contains": "", "note": "阶乘要写 FAC(5)" }
  ]
}
