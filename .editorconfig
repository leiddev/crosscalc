root = true

# 所有文件
[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true

# C++ 源码
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style     = space
indent_size      = 4
max_line_length  = 100

# CMake
[CMakeLists.txt]
indent_style = space
indent_size  = 4

[*.cmake]
indent_style = space
indent_size  = 4

# 前端 / 配置（2 空格缩进）
[*.{html,css,js,mjs,json,jsonc,yml,yaml}]
indent_style = space
indent_size  = 2
max_line_length = 100

# Markdown：保留行尾空格（换行语义）
[*.md]
trim_trailing_whitespace = false

# Windows 脚本用 CRLF
[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line         = crlf
indent_size         = 4
indent_style        = space
